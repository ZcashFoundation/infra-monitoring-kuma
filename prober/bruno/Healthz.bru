meta {
  name: Healthz
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/healthz
  body: none
  auth: none
}

docs {
  Liveness/health summary. Returns 200 with status "ok" when no seeder is a
  hard-down, or 503 with status "degraded" and a `hard_down` list otherwise.
  This is the endpoint Uptime Kuma would monitor (HTTP type, expect 200).
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}
